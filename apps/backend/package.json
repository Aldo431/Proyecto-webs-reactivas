{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "build": "rm -rf out && tsc -p tsconfig.build.json && mkdir -p out/seed && cp src/seed/products.json out/seed/products.json",
    "start": "node --env-file-if-exists=.env out/index.js",
    "dev": "npm run build -w @tiendadcc/utils && node --watch --env-file-if-exists=.env src/index.ts",
    "seed": "node --env-file-if-exists=.env out/scripts/seed.js",
    "make-admin": "node --env-file-if-exists=.env out/scripts/makeAdmin.js",
    "start:e2e": "node src/scripts/e2eServer.ts",
    "test": "vitest run",
    "check": "npm run build -w @tiendadcc/utils && tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "type": "module",
  "dependencies": {
    "@tiendadcc/utils": "^0.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express-rate-limit": "^8.7.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.0",
    "nodemailer": "^10.1.2",
    "zod": "^4.6.3"
  }
}
