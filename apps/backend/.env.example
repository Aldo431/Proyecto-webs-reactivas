# Obligatoria. Cadena de conexión de MongoDB.
# Con Mongo en Docker: `docker run -d --name tiendadcc-mongo -p 27017:27017 mongo:7`
MONGODB_URI=mongodb://localhost:27017/tiendadcc

# Obligatoria. Secreto para firmar los JWT (expiran en 7 días).
# Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio

# Opcional (por defecto 3001). Debe coincidir con el target del proxy de
# apps/frontend/client/vite.config.ts; si lo cambias, actualiza ese archivo.
PORT=3001

# Opcional (por defecto development). development | production | test.
# En producción la cookie de sesión se marca `Secure` y requiere HTTPS.
NODE_ENV=development

# Opcional (por defecto http://localhost:5173). Origen exacto del frontend
# para CORS con credenciales; debe coincidir con cómo abres la app.
CLIENT_ORIGIN=http://localhost:5173

# Configuración SMTP para envío de correos (recuperación de contraseña).
# En desarrollo (NODE_ENV=development) son opcionales: si no están configuradas,
# el token se imprime en consola y se devuelve en la respuesta (campo devToken).
# En producción son obligatorias. En test, Vitest inyecta valores de prueba.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=tu-usuario-smtp
SMTP_PASS=tu-password-smtp
SMTP_FROM=no-reply@example.com

# Solo para `npm run seed -w backend` (no la usa la API). Contraseña del
# vendedor de prueba `vendedor@tiendadcc.cl` (mínimo 8 caracteres). Sin ella el
# seed termina con un mensaje y no escribe nada. Se aplica solo al crear el
# vendedor: si ya existe, su contraseña no cambia.
SEED_SELLER_PASSWORD=cambia-esta-clave-del-vendedor
