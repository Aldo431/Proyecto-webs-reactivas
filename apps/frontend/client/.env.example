# Opcional (por defecto vacío). URL base del backend. Vacío = mismo origen:
# Vite proxya `/api` a http://localhost:3001 (vite.config.ts), de modo que la
# cookie de sesión es del mismo sitio. Recomendado en desarrollo.
VITE_API_URL=

# Alternativa cross-origin (solo para entornos desplegados). Al apuntar
# directamente al backend la llamada deja de ser same-origin y la cookie
# `SameSite=Lax` no se envía, por lo que la sesión no se mantendrá.
# VITE_API_URL=http://localhost:3001
