FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json ./
COPY apps/frontend/client/package.json apps/frontend/client/package.json
COPY apps/backend/package.json apps/backend/package.json
COPY utils/package.json utils/package.json
RUN npm install --ignore-scripts

COPY utils/tsconfig.json utils/tsconfig.build.json utils/
COPY utils/src utils/src
COPY apps/frontend/client apps/frontend/client
RUN npm run build -w @tiendadcc/utils && npm run build -w tiendadcc-client

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/frontend/client/dist /usr/share/nginx/html
EXPOSE 8080
