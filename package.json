{
  "name": "tiendadcc",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/frontend/client",
    "apps/backend",
    "utils"
  ],
  "scripts": {
    "dev": "npm run dev -w tiendadcc-client",
    "build": "npm run build -w tiendadcc-client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run check -w @tiendadcc/utils && npm run check -w backend && npm run check -w tiendadcc-client",
    "e2e:install": "npm --prefix e2etests install && npm --prefix e2etests exec playwright install chromium",
    "e2e": "npm --prefix e2etests test"
  },
  "overrides": {
    "vite": "^6.4.3"
  },
  "dependencies": {
    "express-rate-limit": "^8.7.1",
    "nodemailer": "^10.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
